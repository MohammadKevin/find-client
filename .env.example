# Serper.dev Key (Rekomendasi Utama: Gratis 2.500 pencarian langsung tanpa kartu kredit di serper.dev)
SERPER_API_KEY=your_serper_api_key_here

# SerpApi Key (100 free searches di serpapi.com)
SERPAPI_API_KEY=your_serpapi_api_key_here

# Google Gemini AI Key (for AI personalized value-first message generation)
GEMINI_API_KEY=your_gemini_api_key_here

# Fonnte WhatsApp Gateway API Token & Webhook
FONNTE_TOKEN=your_fonnte_token_here
FONNTE_API_TOKEN=your_fonnte_token_here

# Google Spreadsheet Baru (Leads Machine CRM)
# ID Spreadsheet Google (diambil dari URL docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit)
NEW_SPREADSHEET_ID=your_google_spreadsheet_id_here

# Google Sheets Web App URL (Deploy Apps Script dari menu Deploy > New Deployment > Web App)
GOOGLE_SHEETS_WEBAPP_URL=https://script.google.com/macros/s/your_deployment_id/exec
NEXT_PUBLIC_LEADS_SHEET_API=https://script.google.com/macros/s/your_deployment_id/exec

# Optional: Webhook URL untuk notifikasi lead berminat / ajak meeting
OWNER_NOTIFICATION_WEBHOOK_URL=https://your-webhook-endpoint.com/notify
